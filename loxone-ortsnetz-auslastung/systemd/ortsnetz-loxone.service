[Unit]
Description=Ortsnetz-Auslastung Loxone Miniserver (Dauerbetrieb)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ortsnetz-loxone.env
ExecStart=/usr/bin/python3 /opt/ortsnetz-loxone/ortsnetz_loxone.py
Restart=on-failure
RestartSec=60s

# Läuft als unprivilegierter, temporärer Benutzer, nicht als root.
# Script und Ordner gehören root und sind für diesen Benutzer nicht beschreibbar.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
