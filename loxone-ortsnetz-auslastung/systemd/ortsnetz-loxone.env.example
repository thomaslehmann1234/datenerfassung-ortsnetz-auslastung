# Kopieren nach /etc/ortsnetz-loxone.env, anpassen und mit chmod 600 schützen (enthält das Passwort)
LOXONE_HOST=192.168.1.77
LOXONE_USER=ortsnetz
LOXONE_PASSWORD=
LATITUDE=52.52
LONGITUDE=13.40
# Bezeichnungen der Bausteine in Loxone Config; L2/L3 leer = einphasig
NAME_L1="L1 voltage"
NAME_L2="L2 voltage"
NAME_L3="L3 voltage"
# Optional
#NAME_FREQUENZ="Grid frequency"
#NAME_STROM_L1="L1 current"
#NAME_STROM_L2="L2 current"
#NAME_STROM_L3="L3 current"
#NAME_LEISTUNGSFAKTOR="Power factor"
# Netzleistung am Hausanschluss; Faktor auf W mit Bezug positiv (1000 = kW, -1000 = kW mit Einspeisung positiv)
#NAME_NETZLEISTUNG="grid_power"
#NETZLEISTUNG_FAKTOR=1000
#NAME_SOC="Battery SOC"
#PLANT_CAPACITY_KWP=9.8
# Heutige PV-Prognose in kWh, braucht PLANT_CAPACITY_KWP
#NAME_PV_PROGNOSE="PV forecast today"
#BATTERY_CAPACITY_KWH=10.0
#SMARTMETER_MODEL="Sigenergy SigenStor (Wechselrichter-AC) via Loxone"
