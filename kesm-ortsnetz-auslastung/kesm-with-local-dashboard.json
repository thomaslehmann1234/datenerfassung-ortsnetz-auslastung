    {
        "id": "f2_decode",
        "type": "function",
        "z": "tab_flow2_ksem_flex",
        "name": "Decode L1/L2/L3/Hz",
        "func": "// Single Holding-Register block starting at adr 26 (same mapping as Flow 1).\n// Register map: Hz@26, L1@62, L2@102, L3@142 — each uint32 BE / 1000 over 2 regs.\nconst src = msg.payload;\nlet regs = null;\nif (Array.isArray(src)) {\n  regs = src;\n} else if (src && Array.isArray(src.data)) {\n  regs = src.data;\n} else if (src && src.data && Buffer.isBuffer(src.data)) {\n  const buf = src.data;\n  regs = [];\n  for (let i = 0; i + 1 < buf.length; i += 2) {\n    regs.push(buf.readUInt16BE(i));\n  }\n} else if (Buffer.isBuffer(src)) {\n  regs = [];\n  for (let i = 0; i + 1 < src.length; i += 2) {\n    regs.push(src.readUInt16BE(i));\n  }\n}\n\nif (!regs || regs.length < 118) {\n  node.status({ fill: \"red\", shape: \"ring\", text: \"block incomplete (\" + (regs ? regs.length : 0) + \" regs)\" });\n  node.error(\"Expected >=118 holding registers from adr 26\", msg);\n  return null;\n}\n\nfunction u32beDiv1000(regIndex) {\n  const hi = regs[regIndex] & 0xffff;\n  const lo = regs[regIndex + 1] & 0xffff;\n  return ((hi * 65536) + lo) / 1000;\n}\n\n// Offsets relative to start address 26\nconst values = {\n  Hz: u32beDiv1000(26 - 26),\n  L1: u32beDiv1000(62 - 26),\n  L2: u32beDiv1000(102 - 26),\n  L3: u32beDiv1000(142 - 26)\n};\n\nnode.status({\n  fill: \"green\",\n  shape: \"dot\",\n  text: \"L1=\" + values.L1.toFixed(1) + \" L2=\" + values.L2.toFixed(1) + \" L3=\" + values.L3.toFixed(1) + \" Hz=\" + values.Hz.toFixed(2)\n});\n\nmsg.payload = values;\nmsg.ksem = values;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 180,
        "wires": [
            [
                "f2_api_build",
                "f2_dbg_vals",
                "c9037c9195b5e788"
            ]
        ]
    },
