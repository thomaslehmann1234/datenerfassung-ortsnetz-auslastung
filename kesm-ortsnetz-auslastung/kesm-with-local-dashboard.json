    {
        "id": "f2_api_build",
        "type": "function",
        "z": "tab_flow2_ksem_flex",
        "name": "Payload für API bauen",
        "func": "msg.topic = \"Payload-fuer-API\";\n// Values already decoded in one object from single Modbus block\nconst voltL1 = msg.payload.L1;\nconst voltL2 = msg.payload.L2;\nconst voltL3 = msg.payload.L3;\nconst frequenz = msg.payload.Hz;\n\nconst LATITUDE = 52.66280746;\nconst LONGITUDE = 8.20612926;\n\nmsg.payload = {\n  observed_at: new Date().toISOString(),\n  latitude: LATITUDE,\n  longitude: LONGITUDE,\n  l1_v: Math.round(voltL1 * 10) / 10,\n  l2_v: Math.round(voltL2 * 10) / 10,\n  l3_v: Math.round(voltL3 * 10) / 10,\n  grid_frequency_hz: Math.round(frequenz * 100) / 100,\n  smartmeter_model: \"Kostal KSEM\",\n  integration_version: \"node-red-ksem-2.0.0-flex\"\n};\n\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 160,
        "wires": [
            [
                "f2_http",
                "f2_dbg_api",
                "ce838aa6f231f745"
            ]
        ]
    },
