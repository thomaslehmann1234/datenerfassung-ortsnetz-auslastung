    {
        "id": "ce838aa6f231f745",
        "type": "function",
        "z": "tab_flow2_ksem_flex",
        "name": "set chart payload",
        "func": "// Dashboard 2 ui-chart: Series = msg.topic, Y = msg.payload (number)\n// One message per series — object payload does not create L1/L2/L3/FQ lines.\nconst p = msg.payload || {};\nconst ts = p.observed_at ? Date.parse(p.observed_at) : Date.now();\nconst series = [\n  { topic: \"L1\", value: p.l1_v },\n  { topic: \"L2\", value: p.l2_v },\n  { topic: \"L3\", value: p.l3_v },\n  { topic: \"FQ\", value: p.grid_frequency_hz }\n];\nreturn [series.map((s) => ({\n  topic: s.topic,\n  payload: Number(s.value),\n  timestamp: ts\n}))];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
