# Targets for ./deploy.sh — copy to deploy.env and adjust.
HOST="user@iobroker-host"                    # SSH target of the machine on which ioBroker runs in a container
HOST_SRC="/path/to/iobroker/adapter-src"     # appears in the container as CONTAINER_SRC
CONTAINER_SRC="/opt/iobroker/adapter-src"
IOB_CONTAINER="iobroker"
