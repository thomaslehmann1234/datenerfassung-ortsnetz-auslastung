# Zugangsdaten und Standort – Kopie als .env anlegen (neben dem Script) oder
# nach /etc/ortsnetz-e3dc.env, siehe README.md. Datei mit chmod 600 schützen.

# IP-Adresse des E3/DC-Hauskraftwerks im Heimnetz
E3DC_HOST=192.168.60.220

# Zugang zum E3/DC-Portal (wird für die RSCP-Anmeldung am Hauskraftwerk gebraucht)
E3DC_USERNAME=deine_email@domain.de
E3DC_PASSWORD=dein_portal_passwort

# Lokaler RSCP-Schlüssel: Display > Einstellungen > Personalisieren
RSCP_KEY=dein_rscp_key

# Ungefährer Standort in Dezimalgrad, z. B. von OpenStreetMap
LATITUDE=48.109569
LONGITUDE=11.726477

# Optional: Index des Netzzählers. Leer lassen, wenn der Netzzähler Standard ist –
# das Script sucht dann selbst den Zähler vom Typ PM_TYPE_ROOT.
#METER_INDEX=0

# Optional: installierte PV-Leistung in kWp, für PV-Prognosen.
# Leer lassen = die installierte Spitzenleistung des Kraftwerks wird benutzt.
#PLANT_CAPACITY_KWP=9.8

# Optional: nutzbare Batteriespeicherkapazität in kWh aus dem Datenblatt.
# Leer lassen = die installierte Kapazität des Kraftwerks als Näherung.
#BATTERY_CAPACITY_KWH=10.4

# Optional: freie Bezeichnung des Messgeräts. Leer lassen = Modell des Kraftwerks
# ohne Seriennummer, z. B. "E3/DC S10_Mini". Die Seriennummer ist eine Gerätekennung
# und wird bewusst nicht übertragen; nur hier kann sie ausdrücklich gesetzt werden.
#SMARTMETER_MODEL=E3/DC S10-Mini G3

# Optional: PV-Tagesprognose in kWh. pye3dc liefert keine Prognose, deshalb nur aus
# einer externen Quelle. Reihenfolge: Home Assistant, dann Datei, dann Befehl.
# Alles leer = pv_forecast_kwh wird nicht übertragen.

# Home Assistant REST API: GET /api/states/<entity> mit Authorization: Bearer.
# Token: Long-lived Token, Scope "Read & Historical", in dieser Datei mit chmod 600,
# nie als Befehlsargument und nie im Log.
#PV_FORECAST_HA_URL=http://192.168.60.10:8123
#PV_FORECAST_HA_TOKEN=dein_long_lived_token
# Kommata-Liste der Sensoren; mehrere Sensoren werden addiert (Ost/West je Teilanlage).
# Der Sensor muss Energie in kWh melden (unit_of_measurement: "kWh"), Wh und MWh werden
# umgerechnet, eine unbekannte Einheit (besonders W) wird nicht geraten.
#PV_FORECAST_HA_ENTITY=sensor.pv_prognose_sud,sensor.pv_prognose_west

# Prognosewerte älter als diese Sekunden werden nicht gesendet (nachts behält ein
# Sensor den Abendwert). 0 schaltet die Altersprüfung ab.
# Solcast aktualisiert nur wenige Male am Tag (4–6 h Lücken): für Solcast-Sensoren
# sind 21600 sinnvoll, sonst fällt die Prognose tagsüber meist weg.
#PV_FORECAST_MAX_AGE_S=3600

# Datei mit der kWh-Zahl (evcc, Home Assistant, ioBroker)
#PV_FORECAST_DATEI=/home/username/pv_forecast.json
# Befehl, der die kWh-Zahl in die Standardsausgabe schreibt
#PV_FORECAST_BEFEHL=/usr/local/bin/pv-prognose.sh

# Optional: State-Datei für die Stichproben des Übertragungsintervalls. Leer =
# ~/.local/state/ortsnetz-e3dc/state.json, bei systemd /var/lib/ortsnetz-e3dc/state.json
#STATE_DATEI=/home/username/.local/state/ortsnetz-e3dc/state.json

# Optional: Sendeintervall in Sekunden. Die API erwartet 300, kleiner darf es nicht sein.
#SENDINTERVALL_S=300

# Optional: Zufallsverzögerung vor dem Senden in Sekunden, Standard 60, Maximum 120.
# Alle Integrationen werden per Timer auf die vollen Minuten ausgelöst; ohne Versatz
# treffen alle Messquellen gleichzeitig auf die API. 0 schaltet die Verzögerung aus.
#SENDEZUFALL_S=60
