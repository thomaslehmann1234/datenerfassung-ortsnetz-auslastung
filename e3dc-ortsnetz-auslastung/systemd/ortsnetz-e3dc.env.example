# Kopieren nach /etc/ortsnetz-e3dc.env und anpassen (chmod 600, root)
# IP-Adresse des E3/DC-Hauskraftwerks
E3DC_HOST=192.168.60.220
# Zugang zum E3/DC-Portal
E3DC_USERNAME=deine_email@domain.de
E3DC_PASSWORD=dein_portal_passwort
# Lokaler RSCP-Schlüssel: Display > Einstellungen > Personalisieren
RSCP_KEY=dein_rscp_key
# Standort in Dezimalgrad
LATITUDE=48.109569
LONGITUDE=11.726477
# Optional: Index des Netzzählers, wenn die Installation von der Standardbelegung abweicht
#METER_INDEX=0
# Optional: installierte PV-Leistung in kWp. Leer = die installierte Spitzenleistung des Kraftwerks
#PLANT_CAPACITY_KWP=9.8
# Optional: nutzbare Batteriespeicherkapazität in kWh aus dem Datenblatt.
# Leer = die installierte Kapazität des Kraftwerks als Näherung
#BATTERY_CAPACITY_KWH=10.4
# Optional: freie Bezeichnung des Messgeräts. Leer = Modell und Seriennummer des Kraftwerks
#SMARTMETER_MODEL=E3/DC S10-Mini G3
# Optional: PV-Tagesprognose in kWh. Reihenfolge: Home Assistant, dann Datei, dann Befehl.
# Alles leer = nicht senden.
# Home Assistant REST API, Token: Long-lived Token mit Scope "Read & Historical"
#PV_FORECAST_HA_URL=http://192.168.60.10:8123
#PV_FORECAST_HA_TOKEN=dein_long_lived_token
# Kommata-Liste der Sensoren (werden addiert), Sensor muss unit_of_measurement: kWh haben
#PV_FORECAST_HA_ENTITY=sensor.pv_prognose_sud,sensor.pv_prognose_west
# Prognosewerte älter als diese Sekunden werden nicht gesendet, 0 = Prüfung aus
#PV_FORECAST_MAX_AGE_S=3600
# Prognose aus einer Datei (evcc, Home Assistant, ioBroker)
#PV_FORECAST_DATEI=/var/lib/evcc/pv_forecast.json
#PV_FORECAST_BEFEHL=/usr/local/bin/pv-prognose.sh
# State-Datei wird vom Service auf /var/lib/ortsnetz-e3dc/state.json gesetzt
# Optional: Sendeintervall in Sekunden, darf nicht kleiner als 300 sein
#SENDINTERVALL_S=300
