    {
        "id": "join_data",
        "type": "function",
        "z": "2141aee32c50a56e",
        "name": "Daten sammeln & API Payload bauen",
        "func": "// 1. Werte aus dem Speicher holen (und Standardwerte setzen, falls leer)\nlet l1 = flow.get(\"voltage_l1\");\nlet l2 = flow.get(\"voltage_l2\");\nlet l3 = flow.get(\"voltage_l3\");\nlet freq = flow.get(\"frequency\");\n\n// Falls ein Wert nicht existiert oder keine Zahl ist, Standardwert nutzen\nl1 = (l1 !== undefined && !isNaN(l1)) ? parseFloat(l1) : -1;\nl2 = (l2 !== undefined && !isNaN(l2)) ? parseFloat(l2) : -1;\nl3 = (l3 !== undefined && !isNaN(l3)) ? parseFloat(l3) : -1;\nfreq = (freq !== undefined && !isNaN(freq)) ? parseFloat(freq) : 0.0;\n\n// 2. Koordinaten für: Am Eispfad, Mutterstadt\nlet latitude = 49.44542;\nlet longitude = 8.34593;\n\n// 3. Aktuellen ISO-Zeitstempel generieren\nlet now = new Date().toISOString();\n\n// 4. Payload exakt nach offizieller API-Vorgabe bauen (inkl. Gereatename)\nmsg.payload = {\n    \"observed_at\": now,\n    \"latitude\": latitude,\n    \"longitude\": longitude,\n    \"l1_v\": l1,\n    \"l2_v\": l2,\n    \"l3_v\": l3,\n    \"grid_frequency_hz\": freq,\n    \"smartmeter_model\": \"go-eCharger\" // <-- Hier wird der Gereatename übermittelt\n};\n\n// HTTP Header setzen\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 230,
        "y": 480,
        "wires": [
            [
                "64f08a3da8269a07",
                "c579d3c3b2cc374f"
            ]
        ]
    },
